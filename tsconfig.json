{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"],

    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["./plugins/ModernDashboard/Views/js/*"],
      "@admin/*": ["./resources/js/admin/*"],
      "@lang/*": ["./resources/lang/*"]
    }
  },
  "include": [
    "plugins/ModernDashboard/Views/js",
    "resources/js/admin",
  ]
}
